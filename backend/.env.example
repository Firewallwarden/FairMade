# Set these in the process environment; the app does not auto-load this file.
# Relative SQLite paths resolve from the current working directory.
FAIRMADE_DATABASE_URL=sqlite:///./fairmade.sqlite3
# Empty means no cross-origin browser access. Use exact origins, comma-separated.
FAIRMADE_CORS_ORIGINS=
# Opt-in shared-merchant sandbox only. Configure credentials locally, never in Git.
FAIRMADE_PAYPAL_ENABLED=false
FAIRMADE_PAYPAL_ENVIRONMENT=sandbox
FAIRMADE_PAYPAL_SANDBOX_CLIENT_ID=
FAIRMADE_PAYPAL_SANDBOX_CLIENT_SECRET=
FAIRMADE_PAYPAL_SANDBOX_MERCHANT_ID=
